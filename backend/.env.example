# TaskFlow Pro — Environment Variables
# Copy this file to .env and fill in your values

# Database — Railway PostgreSQL (get from Railway dashboard → your Postgres service → Variables)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Stripe — get these from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Session secret — use a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Port (optional — defaults to 4242)
PORT=4242
